{
  "name": "boqa",
  "version": "1.4.0",
  "description": "Browser Observability & QA \u2014 lean defensive verification kernel",
  "main": "server.js",
  "scripts": {
    "test": "node scripts/run-all-tests.js && node --test spike/boundary-proof/test/boundary-proof.test.js && python -m unittest discover -s kernel/verified-regression/tests -v",
    "start": "node server.js",
    "test:dashboard": "node test/test-dashboard-smoke.js",
    "test:defensive": "node test/test-defensive-private.js && node test/test-public-private-boundary.js",
    "test:browser-scope": "node test/test-browser-scope-guard.js",
    "test:replay": "node test/test-replay-kernel.js",
    "test:v4": "node --test spike/boundary-proof/test/boundary-proof.test.js",
    "test:verified-regression": "python -m unittest discover -s kernel/verified-regression/tests -v",
    "lab:validate-config": "node scripts/local-lab.js validate-config",
    "lab:run-once": "node scripts/local-lab.js run-once",
    "lab:status": "node scripts/local-lab.js status",
    "test:lab": "node test/test-local-lab-runtime.js",
    "test:lab:docker": "node test/test-local-lab-docker.js"
  },
  "keywords": [
    "observability",
    "playwright",
    "instrumentation",
    "security",
    "regression",
    "qa",
    "finding",
    "evidence",
    "disclosure",
    "verification",
    "reproduction",
    "bug",
    "autonomous",
    "discovery",
    "coverage"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "playwright": "^1.41.0",
    "ws": "^8.16.0"
  }
}
