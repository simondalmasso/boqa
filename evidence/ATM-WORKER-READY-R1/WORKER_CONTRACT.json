{
  "entrypoints": [
    "node atm-worker/cli.js run --job <job.json> --run-root <dir>",
    "node atm-worker/cli.js resume --run-root <dir>",
    "node atm-worker/cli.js cancel --run-root <dir>",
    "node atm-worker/cli.js inspect --run-root <dir>"
  ],
  "execution_id": "sha256(worker_source_sha + job_id + work_lease_id + scope_hash)",
  "forbidden_result_authority": [
    "paid",
    "withdrawable",
    "claim_success",
    "submitted_to_marketplace",
    "marketplace_accepted",
    "external_checker_accepted",
    "payout"
  ],
  "job_schema": "boqa_atm_job_v1",
  "max_spend_usd": 0,
  "result_schema": "boqa_atm_result_v1",
  "scope_hash": "sha256(stable_canonical_json({target_repository,target_base_sha,allowed_paths,required_capabilities,frozen_acceptance_criteria,structured_requirements,expected_deliverable,deterministic_checks,max_spend_usd,network_policy,runtime_profile}))",
  "source_support": [
    "PUBLIC_HTTPS_GITHUB_REPOSITORY",
    "ATM_PREFETCHED_LOCAL_SNAPSHOT"
  ],
  "statuses": [
    "COMPLETED",
    "FAILED",
    "REFUSED",
    "CANCELLED",
    "TIMED_OUT",
    "NEEDS_DIFFERENT_WORKER"
  ],
  "unsupported_source": [
    "PRIVATE_REPO_CREDENTIAL_ACQUISITION",
    "SUBMODULES",
    "GIT_LFS"
  ],
  "worker_id": "boqa"
}
